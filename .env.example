# Copy this file to .env and fill in values. .env is git-ignored.

# Port the server listens on
PORT=3000

# Node environment: development | production
NODE_ENV=development

# Google OAuth 2.0 client (Google Cloud Console > APIs & Services > Credentials,
# "OAuth client ID", application type "Web application").
# Add GOOGLE_CALLBACK_URL as an authorized redirect URI on that client.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Secret used to sign session tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me
# How long a login lasts, in seconds (default 86400 = 24 hours)
JWT_EXPIRES_IN_SECONDS=86400

# Where uploaded resumes are stored (default ./data/uploads).
# In Docker this sits on the app-data volume.
UPLOAD_DIR=./data/uploads

# Cloudflare deploys (used by wrangler in cloudflare/). The API token needs
# Workers Scripts, Containers and Workers R2 Storage edit permissions.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Resume analysis: an OpenAI-compatible chat completions API. On Cloudflare the Worker
# sets these itself (Gemini through AI Gateway). Locally you can use Cloudflare's REST
# endpoint with a token that has AI Gateway and Workers AI permissions; leave unset to
# turn analysis off.
AI_BASE_URL=
AI_API_TOKEN=
AI_MODEL=google/gemini-2.5-flash
